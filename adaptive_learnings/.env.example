MONGODB_URI=your_value_here
DATABASE_NAME=ShikshyakAI
ANTHROPIC_API_KEY=your_value_here
# The checkpoint actually lives here; the old path pointed at a directory that
# does not exist, which is why the model was never loaded.
MODEL_CHECKPOINT_PATH=models/best_adaptive_sakt.pth
DEVICE=cpu
# Knowledge tracing authority: off | advisory | active
# advisory = run and report predictions without steering the student.
# The bundled checkpoint is auto-demoted to advisory because it fails its
# calibration probe (saturated difficulty head - no feature scaler was saved).
SAKT_MODE=advisory
# Port the Node backend expects (ADAPTIVE_LEARNING_URL)
ADAPTIVE_PORT=4000
# LLM Configuration
GEMINI_API_KEY=your_value_here